{
  "name": "omnicoder-ui",
  "version": "1.0.2",
  "description": "React UI Components By donjake",
  "type": "module",
  "exports": {
    "./button": {
      "import": "./dist/button/Button.js",
      "require": "./dist/button/Button.cjs"
    },
    "./card": {
      "import": "./dist/card/Card.js",
      "require": "./dist/card/Card.cjs"
    },
    "./input": {
      "import": "./dist/input/Input.js",
      "require": "./dist/input/Input.cjs"
    },
    "./screen": {
      "import": "./dist/screen/Screen.js",
      "require": "./dist/screen/Screen.cjs"
    },
    "./omnicoder-ui-style.css": "./dist/omnicoder-ui-style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:components && npm run build:css",
    "build:components": "tsup src/components/**/*.tsx --format esm,cjs --dts --out-dir dist --clean && cpx \"src/components/omnicoder-ui-style.css\" dist/",
    "build:css": "cat src/components/omnicoder-ui-style.css src/components/**/*.css > dist/omnicoder-ui-style.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coding-donjake/omnicoder-ui.git"
  },
  "keywords": [
    "react",
    "ui"
  ],
  "author": "coding-donjake",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/coding-donjake/omnicoder-ui/issues"
  },
  "homepage": "https://github.com/coding-donjake/omnicoder-ui#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "react-toastify": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "cpx": "^1.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
