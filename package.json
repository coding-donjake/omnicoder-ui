{
  "name": "omnicoder-ui",
  "version": "0.0.2",
  "description": "React UI Components By donjake",
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite demo",
    "build": "tsup src/main.tsx --format esm,cjs --dts --clean",
