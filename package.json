  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coding-donjake/omnicoder-ui.git"
  },
  "keywords": [
    "react",
    "ui"
  ],
  "author": "coding-donjake",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/coding-donjake/omnicoder-ui/issues"
  },
  "homepage": "https://github.com/coding-donjake/omnicoder-ui#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sass": "^1.90.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
